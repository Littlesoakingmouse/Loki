<?xml version="1.0" encoding="utf-8"?>
<!--
    TỔNG QUAN FILE: Manifest chỉ dùng cho bản debug, được Gradle gộp vào manifest chính.

    Thành phần chính:
    - Gắn network_security_config cho phép HTTP tới backend chạy trên máy tính.

    Lưu ý:
    - Bản release không có file này.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug only: lets the emulator reach the local backend over plain HTTP -->
    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>

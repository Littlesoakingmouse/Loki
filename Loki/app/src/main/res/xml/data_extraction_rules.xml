<?xml version="1.0" encoding="utf-8"?>
<!--
    TỔNG QUAN FILE: Quy tắc sao lưu đám mây và chuyển dữ liệu sang máy mới cho Android 12 trở lên.

    Thành phần chính:
    - Cả cloud-backup và device-transfer đều loại trừ token, database cache và outbox.

    Lưu ý:
    - Giữ đồng bộ với backup_rules.xml (Android 11 trở xuống).
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The login token: a restored phone must sign in again -->
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <!-- Cache of the account (refilled from the backend) and unsent photos -->
        <exclude domain="database" path="loki-cache.db" />
        <exclude domain="file" path="outbox" />
    </cloud-backup>
    <device-transfer>
        <!-- The login token: a restored phone must sign in again -->
        <exclude domain="file" path="datastore/session.preferences_pb" />
        <!-- Cache of the account (refilled from the backend) and unsent photos -->
        <exclude domain="database" path="loki-cache.db" />
        <exclude domain="file" path="outbox" />
    </device-transfer>
</data-extraction-rules>
